# Copy this file to .env and fill in values for the services you run.
# The daemon loads .env from the current directory, or ../.env when run
# from a subdirectory.

# Core reporter settings
# LAYER_HOME should point at the Layer home that contains config and keyring files.
LAYER_HOME=/home/reporter/.layer
FROM=your-key-name
KEYRING_BACKEND=file
# Optional for non-interactive file keyring use. The file must be readable by
# the service user and contain the keyring password.
# KEYRING_PASSWORD_FILE=/etc/layer-daemons/reporter-keyring-password
# BROADCAST_MODE=sync
# LOG_LEVEL=info
# PROMETHEUS_PORT=26661

# Layer endpoints.
# RPC_NODES and GRPC_NODES are both required for reporter mode unless supplied
# with --node and --grpc. Values are comma-separated. The first endpoint is
# primary; later endpoints are ordered fallbacks.
RPC_NODES=http://node_endpoint1:26657,http://node_endpoint2:26657
GRPC_NODES=node1:9090,node2:9090

# Token bridge daemon and Ethereum contract custom queries.
# Required for token bridge deposit monitoring and Ethereum contract custom queries.
# Values are comma-separated. The first endpoint is primary; later endpoints are
# used as ordered fallbacks.
ETH_RPC_NODES=https://mainnet.infura.io/v3/YOUR_INFURA_API_KEY,https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Token bridge contracts are hard-coded for tellor-1 and layertest-5.
# This is an optional fallback for running reporterd on local/custom chains.
# TOKEN_BRIDGE_TEST_CONTRACT=0x0000000000000000000000000000000000000000

# Reporter reward withdrawals.
# WITHDRAW_FREQUENCY is in seconds and defaults to 43200 (12 hours) when unset.
# REPORTERS_VALIDATOR_ADDRESS is optional. Set it when the reporter account is
# delegated to a different validator; otherwise the validator operator address
# is derived from FROM.
# REPORTERS_VALIDATOR_ADDRESS=tellorvaloper1...
# WITHDRAW_FREQUENCY=43200

# Optional price guard. If PRICE_GUARD_ENABLED=true, all three related values
# must be set. Threshold is a decimal ratio: 0.5 = 50%, 0.01 = 1%.
# PRICE_GUARD_ENABLED=false
# PRICE_GUARD_THRESHOLD=0.5
# PRICE_GUARD_MAX_AGE=1h
# PRICE_GUARD_UPDATE_ON_BLOCKED=false

# Optional auto-unbonding.
# AUTO_UNBONDING_FREQUENCY=7
# AUTO_UNBONDING_AMOUNT=1000000
# AUTO_UNBONDING_MAX_STAKE_PERCENTAGE=0.1

# Optional auto balance-to-keep bridge. Amounts are in loya; 1 TRB = 1000000 loya.
# AUTO_BALANCE_TO_KEEP=5000000
# AUTO_BALANCE_EXECUTION_TIME=03:00
# AUTO_BALANCE_BRIDGE_TO_ETH_ADDR=0x0000000000000000000000000000000000000000

# Gas estimate cache refresh. Set to 0 to disable.
# REFRESH_GAS_ESTIMATES_INTERVAL=12h

# Optional daemon internals.
# UNIX_SOCKET_ADDRESS=/tmp/daemons.sock
# PANIC_ON_DAEMON_FAILURE_ENABLED=true
# MAX_DAEMON_UNHEALTHY_SECONDS=300
# PRICE_DAEMON_LOOP_DELAY_MS=3000

# Custom query API keys
# These are used by generated custom_query_config.toml entries that reference ${VAR}.
CMC_PRO_API_KEY=your_coinmarketcap_api_key
CGPRO_API_KEY=your_coingecko_pro_api_key
SUBGRAPH_API_KEY=your_the_graph_api_key
